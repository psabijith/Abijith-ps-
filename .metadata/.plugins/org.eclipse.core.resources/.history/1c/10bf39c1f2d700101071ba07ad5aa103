package com.aitrich.multithreading.problem1;

public class SquareOfNumbers extends Thread {

    private int number;

    public SquareOfNumbers(int number) {
        this.number = number;
    }
    public SquareOfNumbers() {
    	
    }

    @Override
    public void run() {
        int square = (int) Math.pow(number, 2);
        System.out.println(
            "Number: " + number +
            ", Square: " + square +
            ", Thread: " + Thread.currentThread().getName()
        );
    }
}
